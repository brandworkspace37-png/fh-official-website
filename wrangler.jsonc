{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "fh-official-website",
  "main": "./worker.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/checkout.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fh-production-db",
      "database_id": "f0d5946f-8487-47a1-977f-dbe060e2ab77",
      "migrations_dir": "migrations"
    }
  ]
}
